# Firebase Configuration
# Copy this file to .env.local and fill in your actual values
# Never commit .env.local to version control
# Create project at: https://console.firebase.google.com
# Enable Authentication (Email/Password + Google + Facebook) and Firestore Database

VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=smartdcabiao
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=1:166828647370:web:6063370981176d1fa8e533

# Facebook App Configuration
# Create app at: https://developers.facebook.com/apps
# Add this to your Firebase Authentication > Sign-in method > Facebook configuration
VITE_FACEBOOK_APP_ID=your_facebook_app_id_here

# Data Source Configuration
# Set to "true" to load businesses and destinations from Firestore
# Set to "false" or omit to use static mock data only
# When true but Firestore is empty/unavailable, falls back to mock data
VITE_USE_FIRESTORE_DATA=false

# Cloudinary (business registration photos — unsigned upload preset)
# Dashboard: https://cloudinary.com/console
# Create an upload preset set to "Unsigned" with folder allowed
VITE_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_cloudinary_unsigned_upload_preset

# IMPORTANT SECURITY NOTES:
# 1. Never commit actual values to version control
# 2. Use .env.local for development
# 3. Use environment-specific variables in production
# 4. Keep API keys secure and rotate regularly
