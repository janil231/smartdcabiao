rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============ HELPER FUNCTIONS ============

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // ============ ADMINS ============

    match /admins/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isAdmin();
    }

    // ============ PUBLIC TOURISM DATA ============

    match /businesses/{businessId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /destinations/{destinationId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ============ SEASONS & SUBCOLLECTIONS ============

    match /seasons/{seasonId} {
      allow read: if true;
      allow write: if isAdmin();

      // Voucher catalog - PUBLIC READ
      match /vouchers/{voucherId} {
        allow read: if true;
        allow write: if isAdmin();
      }

      // Voucher redemptions - user reads own, admin reads all
      match /voucherRedemptions/{redemptionId} {
        allow get: if isAdmin() ||
                    (isSignedIn() && resource.data.uid == request.auth.uid);
        allow list: if isAdmin() ||
                     (isSignedIn() && request.query.uid == request.auth.uid);
        allow create: if isSignedIn() &&
                      request.resource.data.uid == request.auth.uid;
        allow update: if isAdmin();
        allow delete: if false;
      }
    }

    // ============ QUESTS ============

    match /quests/{questId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ============ PARTICIPATIONS ============

    match /participations/{participationId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
                    request.resource.data.uid == request.auth.uid &&
                    request.resource.data.questId is string &&
                    request.resource.data.seasonId is string;
      allow update: if isAdmin() ||
                    (isSignedIn() && resource.data.uid == request.auth.uid);
      allow delete: if false;
    }

    // ============ POINTS LEDGER ============

    match /pointsLedger/{entryId} {
      allow read: if isAdmin() ||
                  (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create: if isSignedIn() &&
                    request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // ============ SEASON BALANCES ============

    match /seasonBalances/{balanceId} {
      allow read: if isAdmin() ||
                  (isSignedIn() && balanceId.matches('.*_' + request.auth.uid + '$'));
      allow create: if isSignedIn() &&
                    request.resource.data.uid == request.auth.uid;
      allow update: if isAdmin() ||
                    (isSignedIn() && request.resource.data.uid == request.auth.uid);
      allow delete: if false;
    }

    // ============ IMPACT LEDGER ============

    match /impactLedger/{entryId} {
      allow read: if isAdmin() ||
                  (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create: if isAdmin() ||
                    (isSignedIn() &&
                     request.resource.data.uid == request.auth.uid &&
                     request.resource.data.reason == 'quest_completed');
      allow update, delete: if false;
    }

    // ============ SEASON USER STATS (leaderboard) ============

    match /seasonUserStats/{statsId} {
      allow read: if true;
      allow create, update: if isAdmin() || isSignedIn();
      allow delete: if false;
    }

    // ============ SUBMISSIONS ============

    match /submissions/{submissionId} {
      allow create: if isSignedIn()
        && (
          !('submittedBy' in request.resource.data)
          || request.resource.data.submittedBy == request.auth.uid
        )
        && (
          !('createdByUid' in request.resource.data)
          || request.resource.data.createdByUid == request.auth.uid
        );
      allow read: if isAdmin() || isSignedIn();
      allow update, delete: if isAdmin();
    }

    // ============ REPORTS ============

    match /reports/{reportId} {
      allow create: if isSignedIn();
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.createdByUid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // ============ REVIEWS ============

    match /reviews/{reviewId} {
      allow read: if resource.data.status == 'approved'
        || (isSignedIn() && resource.data.uid == request.auth.uid)
        || isAdmin();
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if isSignedIn()
        && resource.data.uid == request.auth.uid
        && resource.data.status == 'pending'
        || isAdmin();
      allow delete: if false;
    }

    // ============ USER SETTINGS ============

    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // ============ ADMIN & AUDIT ============

    match /admins/{adminId} {
      allow get: if isSignedIn() && request.auth.uid == adminId;
      allow list: if isAdmin();
      allow write: if false;
    }

    match /auditLogs/{logId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }
  }
}
