rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============ HELPER FUNCTIONS ============

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function getUserRole(uid) {
      return get(/databases/$(database)/documents/admins/$(uid)).data.role;
    }

    function hasLguAccess() {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isMasterAdmin() {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
             (getUserRole(request.auth.uid) == null ||  // backward compat: missing role = master
              getUserRole(request.auth.uid) == 'master');
    }

    // ============ ADMINS (master only) ============

    match /admins/{uid} {
      allow read: if isOwner(uid) || hasLguAccess();
      allow write: if isMasterAdmin();
    }

    // ============ PUBLIC TOURISM DATA ============

    match /businesses/{businessId} {
      allow read: if true;
      allow write: if isMasterAdmin();
    }

    match /destinations/{destinationId} {
      allow read: if true;
      allow write: if isMasterAdmin();
    }

    // ============ SEASONS & SUBCOLLECTIONS ============

    match /seasons/{seasonId} {
      allow read: if true;
      allow write: if isMasterAdmin();

      // Voucher catalog - PUBLIC READ
      match /vouchers/{voucherId} {
        allow read: if true;
        allow write: if isMasterAdmin();
      }

      // Voucher redemptions - user reads own, admin reads all
      match /voucherRedemptions/{redemptionId} {
        allow get: if hasLguAccess() ||
                    (isSignedIn() && resource.data.uid == request.auth.uid);
        allow list: if hasLguAccess() ||
                     (isSignedIn() && request.query.uid == request.auth.uid);
        allow create: if isSignedIn() &&
                      request.resource.data.uid == request.auth.uid;
        allow update: if isMasterAdmin();
        allow delete: if false;
      }
    }

    // ============ QUESTS ============

    match /quests/{questId} {
      allow read: if true;
      allow create, update, delete: if isMasterAdmin();
    }

    // ============ PARTICIPATIONS ============

    match /participations/{participationId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (
        request.resource.data.uid == request.auth.uid ||
        isMasterAdmin()
      ) && request.resource.data.questId is string &&
         request.resource.data.seasonId is string;
      allow update: if isMasterAdmin() ||
                    (isSignedIn() && resource.data.uid == request.auth.uid);
      allow delete: if isMasterAdmin();
    }

    // ============ POINTS LEDGER ============

    match /pointsLedger/{entryId} {
      allow read: if hasLguAccess() ||
                  (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create: if isSignedIn() && (
        request.resource.data.uid == request.auth.uid ||
        isMasterAdmin()
      );
      allow update, delete: if isMasterAdmin();
    }

    // ============ SEASON BALANCES ============

    match /seasonBalances/{balanceId} {
      allow read: if isSignedIn() &&
                  (balanceId.matches('.*_' + request.auth.uid + '$') || hasLguAccess());
      allow create, update: if isMasterAdmin() ||
                    (isSignedIn() && balanceId.matches('.*_' + request.auth.uid + '$'));
      allow delete: if isMasterAdmin();
    }

    // ============ IMPACT LEDGER ============

    match /impactLedger/{entryId} {
      allow read: if hasLguAccess() ||
                  (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create: if isMasterAdmin() ||
                    (hasLguAccess()) ||
                    (isSignedIn() &&
                     request.resource.data.uid == request.auth.uid &&
                     request.resource.data.reason == 'quest_completed');
      allow update, delete: if isMasterAdmin();
    }

    // ============ SEASON USER STATS (leaderboard) ============

    match /seasonUserStats/{statsId} {
      allow read: if true;
      allow create, update: if isMasterAdmin() ||
                    (isSignedIn() && request.resource.data.uid == request.auth.uid);
      allow delete: if isMasterAdmin();
    }

    // ============ SUBMISSIONS ============

    match /submissions/{submissionId} {
      allow create: if isSignedIn()
        && (
          !('submittedBy' in request.resource.data)
          || request.resource.data.submittedBy == request.auth.uid
        )
        && (
          !('createdByUid' in request.resource.data)
          || request.resource.data.createdByUid == request.auth.uid
        );
      allow read: if hasLguAccess() || isSignedIn();
      allow update, delete: if isMasterAdmin();
    }

    // ============ REPORTS ============

    match /reports/{reportId} {
      allow create: if isSignedIn();
      allow read: if hasLguAccess()
        || (isSignedIn() && resource.data.createdByUid == request.auth.uid);
      allow update, delete: if isMasterAdmin();
    }

    // ============ REVIEWS ============

    match /reviews/{reviewId} {
      allow read: if resource == null
        || resource.data.status == 'approved'
        || (isSignedIn() && resource.data.uid == request.auth.uid)
        || hasLguAccess();
      allow create: if isSignedIn()
        && (
          (request.resource.data.uid == request.auth.uid
           && request.resource.data.status == 'pending')
          || isMasterAdmin()
        );
      allow update: if isSignedIn()
        && resource.data.uid == request.auth.uid
        && resource.data.status == 'pending'
        || isMasterAdmin();
      allow delete: if false;
    }

    // ============ USERS COLLECTION ============
    // Auto-populated on sign-in by upsertUserProfile()
    // Used by Manage Admins panel for searchable user list

    match /users/{uid} {
      allow read: if isSignedIn() && (
        request.auth.uid == uid ||
        hasLguAccess()
      );

      allow create, update: if isMasterAdmin() ||
        (request.auth != null && request.auth.uid == uid);

      allow delete: if isMasterAdmin();
    }

    match /userBadges/{docId} {
      allow read: if isSignedIn() && (
        docId.matches('.*_' + request.auth.uid + '$') ||
        hasLguAccess()
      );

      allow create, update: if request.auth != null && (
        docId.matches('.*_' + request.auth.uid + '$') ||
        isMasterAdmin()
      );

      allow delete: if false;
    }

    // ============ ADMIN & AUDIT ============

    match /auditLogs/{logId} {
      allow read, create: if hasLguAccess();
      allow update, delete: if false;
    }

    // ============ OWNER QUESTS (Business Owner System) ============

    match /ownerQuests/{questId} {
      allow read: if true;
      allow create: if isSignedIn() && (
        request.resource.data.ownerUid == request.auth.uid ||
        isMasterAdmin()
      );
      allow update: if isSignedIn() && (
        resource.data.ownerUid == request.auth.uid ||
        isMasterAdmin()
      );
      allow delete: if isMasterAdmin();
    }

    match /ownerQuestParticipations/{participationId} {
      allow read: if isSignedIn();
      allow create, update: if isMasterAdmin() ||
        (isSignedIn() && request.resource.data.uid == request.auth.uid);
      allow delete: if isMasterAdmin();
    }

    match /businessQuestRewards/{rewardId} {
      allow read: if isSignedIn() && (
        resource.data.uid == request.auth.uid ||
        resource.data.ownerUid == request.auth.uid ||
        hasLguAccess()
      );
      allow create: if isSignedIn() && (
        request.resource.data.uid == request.auth.uid ||
        isMasterAdmin()
      );
      allow update: if isSignedIn() && (
        resource.data.ownerUid == request.auth.uid ||
        isMasterAdmin()
      );
      allow delete: if false;
    }

    // ============ APP META (data version for cache invalidation) ============

    match /appMeta/{docId} {
      allow read: if true;
      allow write: if isMasterAdmin() || hasLguAccess();
    }
  }
}
